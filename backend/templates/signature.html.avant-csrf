{% extends "base.html" %}

{% block title %}Prévial — Signature{% endblock %}

{% block content %}
<div class="form-wrap" style="max-width:520px; text-align:center;">
  <h1>Signez votre contrat</h1>
  <p class="intro">{{ produit.nom }} — {{ devis.montant }}€ / mois</p>

  <div style="background:#fff; border:1px solid var(--line); border-radius:8px; padding:24px; text-align:left; margin:24px 0;">
    <p style="font-size:13px; color:var(--muted); margin:0;">
      En signant, vous confirmez avoir pris connaissance des conditions de ce contrat
      et donnez votre accord pour sa mise en place.
    </p>
  </div>

  <p style="font-size:13px; color:var(--ink); font-weight:600; text-align:left;">Signez ci-dessous avec votre souris :</p>

  <canvas id="zone-signature" width="472" height="180" style="border:1px solid var(--line); border-radius:8px; background:#fff; cursor:crosshair;"></canvas>

  <div style="text-align:right; margin-top:8px;">
    <button type="button" id="btn-effacer" style="background:none; border:none; color:var(--muted); font-size:12px; cursor:pointer; text-decoration:underline;">Effacer</button>
  </div>

  <form method="POST" action="/dossiers/{{ dossier.id }}/signature" id="form-signature">
    <input type="hidden" name="signature_data" id="signature_data">

    <label style="display:flex; align-items:flex-start; gap:8px; text-align:left; font-size:13px; margin:20px 0;">
      <input type="checkbox" name="consentement" required style="margin-top:3px;">
      Je certifie l'exactitude des informations fournies et j'accepte de signer électroniquement ce contrat.
    </label>
    <button type="submit" class="btn-primary" style="width:100%;" id="btn-signer" disabled>Signer et finaliser</button>
  </form>
</div>

<script>
const canvas = document.getElementById('zone-signature');
const ctx = canvas.getContext('2d');
let enTrainDeDessiner = false;

ctx.strokeStyle = '#1C2B45';
ctx.lineWidth = 2;
ctx.lineCap = 'round';

function position(e) {
  const rect = canvas.getBoundingClientRect();
  return { x: e.clientX - rect.left, y: e.clientY - rect.top };
}

canvas.addEventListener('mousedown', (e) => {
  enTrainDeDessiner = true;
  const p = position(e);
  ctx.beginPath();
  ctx.moveTo(p.x, p.y);
  document.getElementById('btn-signer').disabled = false;
});

canvas.addEventListener('mousemove', (e) => {
  if (!enTrainDeDessiner) return;
  const p = position(e);
  ctx.lineTo(p.x, p.y);
  ctx.stroke();
});

canvas.addEventListener('mouseup', () => { enTrainDeDessiner = false; });
canvas.addEventListener('mouseleave', () => { enTrainDeDessiner = false; });

document.getElementById('btn-effacer').addEventListener('click', () => {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  document.getElementById('btn-signer').disabled = true;
});

document.getElementById('form-signature').addEventListener('submit', () => {
  document.getElementById('signature_data').value = canvas.toDataURL('image/png');
});
</script>
{% endblock %}
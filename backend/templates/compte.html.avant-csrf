{% extends "base.html" %}

{% block title %}Prévial — Mon compte{% endblock %}

{% block content %}
<div class="form-wrap" style="max-width:420px; text-align:center;">
  <h1>Mon compte</h1>

  <div style="display:flex; justify-content:center; gap:10px; margin-bottom:24px;">
    <div id="btn-connexion" style="cursor:pointer; padding:8px 16px; border-radius:20px; font-size:13px; font-weight:600; background:var(--ink); color:#fff;">Connexion</div>
    <div id="btn-inscription" style="cursor:pointer; padding:8px 16px; border-radius:20px; font-size:13px; font-weight:600; background:var(--line); color:var(--ink);">Créer un compte</div>
  </div>

  {% if erreur %}
    <p style="color:#B23B3B; font-size:13.5px; margin-bottom:16px;">{{ erreur }}</p>
  {% endif %}

  <div id="panel-connexion">
    <form method="POST" action="/compte">
      <div class="form-group" style="text-align:left;">
        <label>E-mail</label>
        <input type="email" name="email" required>
      </div>
      <div class="form-group" style="text-align:left;">
        <label>Mot de passe</label>
        <input type="password" name="mot_de_passe" required>
      </div>
      <button type="submit" class="btn-primary" style="width:100%;">Se connecter</button>
    </form>
  </div>

  <div id="panel-inscription" style="display:none;">
    <form method="POST" action="/inscription">
      <div class="form-group" style="text-align:left;">
        <label>Nom</label>
        <input type="text" name="nom" required>
      </div>
      <div class="form-group" style="text-align:left;">
        <label>Prénom</label>
        <input type="text" name="prenom" required>
      </div>
      <div class="form-group" style="text-align:left;">
        <label>E-mail</label>
        <input type="email" name="email" required>
      </div>
      <div class="form-group" style="text-align:left;">
        <label>Mot de passe</label>
        <input type="password" name="mot_de_passe" required>
      </div>
      <button type="submit" class="btn-primary" style="width:100%;">Créer mon compte</button>
    </form>
  </div>
</div>

<script>
  const btnConnexion = document.getElementById('btn-connexion');
  const btnInscription = document.getElementById('btn-inscription');
  const panelConnexion = document.getElementById('panel-connexion');
  const panelInscription = document.getElementById('panel-inscription');

  btnConnexion.addEventListener('click', () => {
    panelConnexion.style.display = 'block';
    panelInscription.style.display = 'none';
    btnConnexion.style.background = 'var(--ink)'; btnConnexion.style.color = '#fff';
    btnInscription.style.background = 'var(--line)'; btnInscription.style.color = 'var(--ink)';
  });
  btnInscription.addEventListener('click', () => {
    panelInscription.style.display = 'block';
    panelConnexion.style.display = 'none';
    btnInscription.style.background = 'var(--ink)'; btnInscription.style.color = '#fff';
    btnConnexion.style.background = 'var(--line)'; btnConnexion.style.color = 'var(--ink)';
  });
</script>
{% endblock %}